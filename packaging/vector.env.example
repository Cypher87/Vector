# Standalone installation: Vector reads readsb files directly.
READSB_SOURCE=local
READSB_LIVE_DIR=/run/readsb
READSB_HISTORY_DIR=/var/globe_history
VECTOR_AIRCRAFT_DATABASE=/var/lib/vector/aircraft-db/aircraft.csv.gz

# A development PC can use the standalone Vector instance on its Pi instead:
# READSB_SOURCE=vector
# READSB_REMOTE_URL=http://receiver.local:3000/

# Public interface labels and defaults.
VECTOR_SITE_NAME=Vector
VECTOR_RECEIVER_TITLE="Local readsb receiver"
VECTOR_UNIT_SYSTEM=metric
VECTOR_MAP_STYLE_URL=/map-style.json

# Anonymous device synchronization. This state remains outside the Git checkout.
VECTOR_SYNC_STORE=/var/lib/vector/sync.json

# Optional receiver position. When omitted, Vector uses coordinates from receiver.json.
# Configure both values together, using decimal degrees.
# VECTOR_RECEIVER_LATITUDE=52.000000
# VECTOR_RECEIVER_LONGITUDE=5.000000

# Vinext standalone server binding.
HOST=0.0.0.0
PORT=3000
