# Upstream readsb/tar1090 locations. These URLs are read only by the Vector server.
READSB_LIVE_URL=http://127.0.0.1/tar1090/data/
READSB_HISTORY_URL=http://127.0.0.1/tar1090/globe_history/
# Optional when tar1090 is not the parent directory of READSB_LIVE_URL.
# READSB_TAR1090_URL=http://127.0.0.1/tar1090/

# Public interface labels and defaults.
VECTOR_SITE_NAME=Vector
VECTOR_RECEIVER_TITLE="Local readsb receiver"
VECTOR_UNIT_SYSTEM=metric
VECTOR_MAP_STYLE_URL=/map-style.json

# Accounts and synchronized user preferences. The first local account can be
# created from the interface; registration closes after that by default.
VECTOR_ACCOUNT_STORE=/var/lib/vector/accounts.json
VECTOR_LOCAL_REGISTRATION=first-user

# Google and Apple sign-in are optional and require a public HTTPS address.
# Never commit these credentials. See the README for provider setup.
# VECTOR_PUBLIC_URL=https://radar.example.com
# VECTOR_GOOGLE_CLIENT_ID=
# VECTOR_GOOGLE_CLIENT_SECRET=
# VECTOR_APPLE_CLIENT_ID=
# VECTOR_APPLE_TEAM_ID=
# VECTOR_APPLE_KEY_ID=
# VECTOR_APPLE_PRIVATE_KEY_FILE=/etc/vector/apple-private-key.p8

# Optional receiver position. When omitted, Vector uses coordinates from receiver.json.
# Configure both values together, using decimal degrees.
# VECTOR_RECEIVER_LATITUDE=52.000000
# VECTOR_RECEIVER_LONGITUDE=5.000000

# Vinext standalone server binding.
HOST=0.0.0.0
PORT=3000
